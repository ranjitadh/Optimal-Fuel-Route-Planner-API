# =============================================================================
# Optimal Fuel Route Planner — environment template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. This template holds only
# placeholders and is safe to commit to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
# Secret key used for cryptographic signing (sessions, CSRF, password resets).
# REQUIRED in production. Generate a fresh one with:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# If unset, an insecure development fallback is used.
DJANGO_SECRET_KEY=change-me-in-production

# Debug mode. True enables detailed error pages; NEVER enable in production.
# Accepts: True / False (also 1/0, yes/no).
DJANGO_DEBUG=True

# Hosts allowed to serve the app, comma-separated. When empty it defaults to
# '*' while DEBUG is on (local dev). Set this in production, e.g.
#   DJANGO_ALLOWED_HOSTS=myapp.onrender.com,www.example.com
# For a Render app the value "myapp.onrender.com" (or ".onrender.com") works.
DJANGO_ALLOWED_HOSTS=

# Full origins allowed to submit unsafe requests (needed for CSRF over HTTPS),
# comma-separated, e.g. DJANGO_CSRF_TRUSTED_ORIGINS=https://myapp.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Engine to use: `sqlite` (default, zero-config, uses ./db.sqlite3) or `mysql`.
# All DB_* values below are only read when DB_ENGINE=mysql.
DB_ENGINE=sqlite

# MySQL settings (ignored when DB_ENGINE=sqlite). Requires `pymysql` installed.
DB_NAME=fuel_routing_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306


# -----------------------------------------------------------------------------
# API keys (optional)
# -----------------------------------------------------------------------------
# CARTO API key — enables the CARTO light/dark basemap tiles in the dashboard.
# Without it the map falls back to the free OpenStreetMap basemap.
# Get one at https://carto.com/ (Account > API keys).
CARTO_API_KEY=

# Generic API key. Used as a fallback for CARTO_API_KEY when the latter is
# unset (see core/settings.py), so you only need to fill in one of the two.
API_KEY=
